{
    "name" : "poppy/aliyun-push",
    "description" : "Poppy Aliyun Push Extension.",
    "license" : "MIT",
    "type" : "poppy",
    "authors" : [
        {
            "name" : "Mark Zhao",
            "email" : "zhaody901@126.com"
        }
    ],
    "require" : {
        "php" : ">=7.4",
        "alibabacloud/push-20160801" : "1.*"
    },
    "require-dev" : {
        "roave/security-advisories" : "dev-latest"
    },
    "autoload" : {
        "psr-4" : {
            "Poppy\\AliyunPush\\" : "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Poppy\\AliyunPush\\Tests\\" : "tests/"
        }
    },
    "config" : {
        "preferred-install" : "dist"
    },
    "minimum-stability" : "dev"
}