{
    "name": "wulicode/poppy",
    "version": "4.2",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-simplexml": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-bcmath": "*",
        "ext-fileinfo": "*",
        "ext-libxml": "*",
        "ext-xml": "*",
        "ext-curl": "*",
        "symfony/console": "4.*",
        "symfony/finder": "4.*",
        "symfony/yaml": "5.*",
        "elasticsearch/elasticsearch": "7.*",
        "jenssegers/date": "^4.0",
        "laravel/framework": "6.*",
        "intervention/image": "2.*",
        "laravelcollective/html": "^6.0",
        "predis/predis": "~1.1",
        "aliyuncs/oss-sdk-php": "^2.3",
        "tucker-eric/eloquentfilter": "^3",
        "tymon/jwt-auth": "1.0.*",
        "hieu-le/active": "4.0.*",
        "alibabacloud/client": "^1.5",
        "alibabacloud/push": "^1.8",
        "alibabacloud/dysmsapi": "^1.8",
        "alibabacloud/sts": "^1.8",
        "mlocati/ip-lib": "^1.16",
        "guzzlehttp/guzzle": "^6.3|^7.3",
        "overtrue/pinyin": "^4.0",
        "hamcrest/hamcrest-php": "^2.0.1",
        "nikic/php-parser": "^4.15",
        "sentry/sentry-laravel": "3.*",
        "ezyang/htmlpurifier": "^4.16",
        "psr/http-factory-implementation": "*",
        "mews/captcha": "3.2.*",
        "twbs/bootstrap-icons": "^1.10",
        "php-curl-class/php-curl-class": "^9.17",
        "poppy/framework": "*@dev",
        "poppy/mgr-page": "*@dev",
        "poppy/system": "*@dev",
        "poppy/core": "*@dev",
        "poppy/ext-app": "*@dev",
        "poppy/ext-ip_store": "*@dev",
        "poppy/ad": "*@dev",
        "poppy/aliyun-oss": "*@dev",
        "poppy/aliyun-push": "*@dev",
        "poppy/app": "*@dev",
        "poppy/area": "*@dev",
        "poppy/category": "*@dev",
        "poppy/content": "*@dev",
        "poppy/im-rpc": "*@dev",
        "poppy/sensitive-word": "*@dev",
        "poppy/sms": "*@dev",
        "alibabacloud/dysmsapi-20170525": "^4.6"
    },
    "require-dev": {
        "mockery/mockery": "^1.5.1",
        "itsgoingd/clockwork": "^5.1",
        "barryvdh/laravel-ide-helper": "2.8.*",
        "doctrine/dbal": "^2.6",
        "phpunit/phpunit": "^9.6",
        "kitloong/laravel-migrations-generator": "^5.2"
    },
    "autoload": {
        "psr-4": {
            "Demo\\": "modules/demo/src/",
            "Demo\\Tests\\": "modules/demo/tests/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Poppy\\Sms\\Tests\\": "poppy/sms/tests/",
            "Poppy\\System\\Tests\\": "poppy/system/tests/",
            "Poppy\\Core\\Tests\\": "poppy/core/tests/",
            "Poppy\\Extension\\Alipay\\Tests\\": "poppy/ext-alipay/tests",
            "Poppy\\Extension\\IpStore\\Tests\\": "poppy/ext-ip_store/tests",
            "Poppy\\Faker\\Tests\\": "poppy/faker/tests",
            "Poppy\\Framework\\Tests\\": "poppy/framework/tests",
            "Poppy\\MgrPage\\Tests\\": "poppy/mgr-page/tests/",
            "Poppy\\Area\\Tests\\": "poppy/area/tests",
            "Poppy\\Version\\Tests\\": "poppy/version/tests",
            "Poppy\\Content\\Tests\\": "poppy/content/tests",
            "Poppy\\AliyunPush\\Tests\\": "poppy/aliyun-push/tests",
            "Poppy\\SensitiveWord\\Tests\\": "poppy/sensitive-word/tests",
            "Poppy\\AliyunOss\\Tests\\": "poppy/aliyun-oss/tests"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "poppy/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravelcollective/html"
            ]
        }
    },
    "scripts": {
        "release:check": [
            "bash .github/scripts/release.sh --help 2>/dev/null; bash -c '.github/scripts/release.sh dryrun-check 2>&1 | head -40'"
        ],
        "release:dry-run": [
            "bash .github/scripts/release.sh 4.2.1-rc1 '' '' --dry-run"
        ],
        "post-install-cmd": [
            "php artisan clear-compiled",
            "php artisan ide-helper:generate"
        ],
        "pre-update-cmd": [
        ],
        "post-update-cmd": [
            "php artisan clear-compiled",
            "php artisan ide-helper:generate",
            "php artisan ide-helper:meta"
        ],
        "post-root-package-install": [
            "php -r \"copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php -r \"copy('.env.example', '.env');\"",
            "php artisan key:generate"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "allow-plugins": {
            "php-http/discovery": false
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
