{
    "name": "wulicode/poppy",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-simplexml": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-bcmath": "*",
        "ext-fileinfo": "*",
        "ext-libxml": "*",
        "ext-xml": "*",
        "ext-curl": "*",
        "symfony/console": "4.*",
        "symfony/finder": "4.*",
        "symfony/yaml": "4.*",
        "elasticsearch/elasticsearch": "7.*",
        "jenssegers/date": "^4.0",
        "laravel/framework": "6.*",
        "intervention/image": "2.*",
        "laravelcollective/html": "^6.0",
        "predis/predis": "~1.1",
        "aliyuncs/oss-sdk-php": "^2.3",
        "tucker-eric/eloquentfilter": "^3",
        "tymon/jwt-auth": "1.0.*",
        "hieu-le/active": "4.0.*",
        "alibabacloud/client": "^1.5",
        "alibabacloud/push": "^1.8",
        "alibabacloud/dysmsapi": "^1.8",
        "alibabacloud/sts": "^1.8",
        "mlocati/ip-lib": "^1.16",
        "guzzlehttp/guzzle": "^7.3",
        "overtrue/pinyin": "^4.0",
        "ovidigital/js-object-to-json": "^1.0",
        "hamcrest/hamcrest-php": "^2.0.1",
        "nikic/php-parser": "^4.15",
        "sentry/sentry-laravel": "3.*",
        "ezyang/htmlpurifier": "^4.16",
        "psr/http-factory-implementation": "*"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "mockery/mockery": "^1.5.1",
        "itsgoingd/clockwork": "^5.1",
        "barryvdh/laravel-ide-helper": "2.8.*",
        "doctrine/dbal": "^2.6",
        "kitloong/laravel-migrations-generator": "^5.2"
    },
    "autoload": {
        "psr-4": {
            "Poppy\\Extension\\Alipay\\": "poppy/ext-alipay/src",
            "Poppy\\Extension\\Alipay\\Tests\\": "poppy/ext-alipay/tests",
            "Poppy\\Extension\\IpStore\\": "poppy/ext-ip_store/src",
            "Poppy\\Extension\\IpStore\\Tests\\": "poppy/ext-ip_store/tests",
            "Poppy\\Extension\\Phpstan\\": "poppy/ext-phpstan/src",
            "Poppy\\Faker\\": "poppy/faker/src",
            "Poppy\\Faker\\Tests\\": "poppy/faker/tests",
            "Poppy\\Framework\\": "poppy/framework/src",
            "Poppy\\Framework\\Tests\\": "poppy/framework/tests",
            "Poppy\\Core\\": "poppy/core/src",
            "Poppy\\Core\\Tests\\": "poppy/core/tests",
            "Poppy\\System\\": "poppy/system/src",
            "Poppy\\System\\Tests\\": "poppy/system/tests",
            "Poppy\\MgrPage\\": "poppy/mgr-page/src/",
            "Poppy\\MgrPage\\Tests\\": "poppy/mgr-page/tests/",
            "Poppy\\MgrApp\\": "poppy/mgr-app/src/",
            "Poppy\\MgrApp\\Tests\\": "poppy/mgr-app/tests/",
            "Poppy\\Ad\\": "poppy/ad/src",
            "Poppy\\Ad\\Tests\\": "poppy/ad/tests",
            "Poppy\\Area\\": "poppy/area/src",
            "Poppy\\Area\\Tests\\": "poppy/area/tests",
            "Poppy\\Sms\\": "poppy/sms/src",
            "Poppy\\Sms\\Tests\\": "poppy/sms/tests",
            "Poppy\\Version\\": "poppy/version/src",
            "Poppy\\Version\\Tests\\": "poppy/version/tests",
            "Poppy\\AliyunPush\\": "poppy/aliyun-push/src",
            "Poppy\\AliyunPush\\Tests\\": "poppy/aliyun-push/tests",
            "Poppy\\SensitiveWord\\": "poppy/sensitive-word/src",
            "Poppy\\SensitiveWord\\Tests\\": "poppy/sensitive-word/tests",
            "Poppy\\AliyunOss\\": "poppy/aliyun-oss/src",
            "Poppy\\AliyunOss\\Tests\\": "poppy/aliyun-oss/tests",
            "Poppy\\CodeGenerator\\": "poppy/code-generator/src/",
            "Demo\\": "modules/demo/src/",
            "Demo\\Tests\\": "modules/demo/tests/"
        },
        "files": [
            "poppy/framework/src/Support/functions.php",
            "poppy/system/src/Support/functions.php",
            "poppy/core/src/Support/functions.php",
            "poppy/sensitive-word/src/Support/functions.php"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravelcollective/html"
            ]
        }
    },
    "scripts": {
        "codeup": [
            "git subtree push --prefix=poppy/framework  codeup-framework 4.2",
            "git subtree push --prefix=poppy/mgr-page  codeup-mgr-page 4.2",
            "git subtree push --prefix=poppy/mgr-app  codeup-mgr-app 4.2",
            "git subtree push --prefix=poppy/core  codeup-core 4.2",
            "git subtree push --prefix=poppy/system  codeup-system 4.2",
            "git subtree push --prefix=poppy/faker  codeup-faker 4.2",
            "git subtree push --prefix=poppy/version  codeup-version 4.2",
            "git subtree push --prefix=poppy/aliyun-oss  codeup-aliyun-oss 4.2",
            "git subtree push --prefix=poppy/aliyun-push  codeup-aliyun-push 4.2",
            "git subtree push --prefix=poppy/area  codeup-area 4.2",
            "git subtree push --prefix=poppy/sensitive-word  codeup-sensitive-word 4.2",
            "git subtree push --prefix=poppy/sms  codeup-sms 4.2",
            "git subtree push --prefix=poppy/ext-alipay  codeup-ext-alipay 4.2",
            "git subtree push --prefix=poppy/ext-ip_store  codeup-ext-ip_store 4.2",
            "git subtree push --prefix=poppy/ad  codeup-ad 4.2",
            "git subtree push --prefix=poppy/code-generator codeup-code-generator 4.2",
            "git subtree push --prefix=poppy/ext-phpstan codeup-ext-phpstan 4.2"
        ],
        "post-install-cmd": [
            "php artisan clear-compiled",
            "php artisan ide-helper:generate"
        ],
        "pre-update-cmd": [
        ],
        "post-update-cmd": [
            "php artisan clear-compiled",
            "php artisan ide-helper:generate",
            "php artisan ide-helper:meta"
        ],
        "post-root-package-install": [
            "php -r \"copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php -r \"copy('.env.example', '.env');\"",
            "php artisan key:generate"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
